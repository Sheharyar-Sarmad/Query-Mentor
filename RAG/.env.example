
# ============================================================
# QueryMentor — Environment Variables
# ============================================================

# ─── Phase ──────────────────────────────────────────────────
APP_PHASE=development

# ─── Required Secrets ───────────────────────────────────────
GROQ_API_KEY=your_groq_api_key
PINECONE_API_KEY=your_pinecone_api_key

# ─── Pinecone ───────────────────────────────────────────────
PINECONE_INDEX_NAME=querymentor
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ─── LLM ────────────────────────────────────────────────────
# openai/gpt-oss-120b = high quality, slow (~5-15s per call, reasoning model)
# openai/gpt-oss-20b  = fast (~1-3s per call), good quality
LLM_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# ─── Embeddings ─────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ─── RAG Tuning ─────────────────────────────────────────────
RETRIEVER_K=5
RETRIEVER_FETCH_K=15
RETRIEVER_LAMBDA=0.5
CHUNK_SIZE=900
CHUNK_OVERLAP=120

# ─── Cache Tuning ───────────────────────────────────────────
CACHE_DIR=cache
CACHE_L1_MAXSIZE=512
CACHE_L1_TTL=3600
CACHE_L2_TTL=604800
CACHE_L3_TTL=604800
CACHE_SEMANTIC_THRESHOLD=0.85

# ─── Rate Limit ─────────────────────────────────────────────
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=60
